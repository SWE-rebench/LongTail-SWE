FROM --platform=linux/amd64 docker.io/library/elixir:1.18.4-otp-27

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC LANG=C.UTF-8 LC_ALL=C.UTF-8 ELIXIR_ERL_OPTIONS=+fnu \
    MIX_HOME=/workspace/.mix HEX_HOME=/workspace/.hex \
    REBAR_CACHE_DIR=/workspace/.cache/rebar3 XDG_CACHE_HOME=/workspace/.cache \
    XDG_CONFIG_HOME=/workspace/.config XDG_DATA_HOME=/workspace/.local/share

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends git curl wget unzip zip ca-certificates \
      build-essential pkg-config cmake gnupg inotify-tools python3 python3-pip python3-venv \
      rustc cargo libssl-dev zlib1g-dev libgmp-dev libffi-dev; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg; \
    echo 'deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main' \
      > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*

RUN node --version | grep -E '^v2[4-9]\.'; \
    mkdir -p /workspace; \
    mix local.hex --force; \
    mix local.rebar --force; \
    chmod -R 777 /workspace; \
    adduser --disabled-password --gecos 'dog' nonroot
WORKDIR /workspace
