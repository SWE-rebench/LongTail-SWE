FROM --platform=linux/amd64 ghcr.io/cirruslabs/flutter:3.44.0@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8 AS dart_base

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC \
    CI=true \
    PUB_CACHE=/workspace/.pub-cache \
    HOME=/workspace \
    CHROME_EXECUTABLE=/usr/bin/google-chrome \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    LD_LIBRARY_PATH=/usr/lib/jvm/java-21-openjdk-amd64/lib

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    clang \
    cmake \
    curl \
    file \
    git \
    gnupg \
    jq \
    libasound2t64 \
    libgtk-3-0 \
    libnss3 \
    libsqlite3-dev \
    libstdc++-14-dev \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    ripgrep \
    unzip \
    wget \
    xvfb \
    xz-utils \
    zip \
 && install -d -m 0755 /etc/apt/keyrings \
 && wget -q -O - https://dl.google.com/linux/linux_signing_key.pub \
    | gpg --dearmor -o /etc/apt/keyrings/google-linux.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-linux.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace/.pub-cache/bin /workspace/.config /workspace/.cache \
 && chmod -R 0777 /workspace \
 && git config --global --add safe.directory '*' \
 && dart --disable-analytics \
 && flutter config --no-analytics --enable-web \
 && flutter precache --linux --web \
 && dart pub global activate melos \
 && dart pub global activate very_good_cli

ENV PATH=/workspace/.pub-cache/bin:/sdks/flutter/bin:/sdks/flutter/bin/cache/dart-sdk/bin:/opt/android-sdk-linux/cmdline-tools/latest/bin:/opt/android-sdk-linux/platform-tools:/opt/android-sdk-linux/emulator:${JAVA_HOME}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN set -eux; \
    dart --version; \
    flutter --version; \
    command -v dart; \
    command -v flutter; \
    command -v melos; \
    command -v very_good; \
    command -v google-chrome; \
    command -v xvfb-run; \
    command -v java; \
    command -v sdkmanager; \
    command -v git; \
    command -v cmake; \
    command -v ninja; \
    command -v rg; \
    java -version; \
    sdkmanager --version

WORKDIR /workspace
