# Narrow gperf 3.1 toolchain cohort required by AtomVM.
FROM erlang_base:v2026-08-18-erlang-otp27-rebench
USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gperf=3.1-1 \
 && rm -rf /var/lib/apt/lists/* \
 && gperf --version | head -1 | grep -F '3.1'
WORKDIR /workspace
