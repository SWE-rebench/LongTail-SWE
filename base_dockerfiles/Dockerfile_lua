# Lua validation base for Longtail-SWE Lua tasks.
# Builds from the existing minimal lua_base digest and adds the tooling needed by
# Neovim-heavy Lua benchmark rows.

FROM --platform=linux/amd64 lua_base:minimal AS lua_base

ARG DEBIAN_FRONTEND=noninteractive
ARG NVIM_VERSION=v0.12.3
ENV TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN set -eux; \
    apt-get update -qq; \
    apt-get install -y -qq --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        wget \
        git \
        unzip \
        zip \
        xz-utils \
        tar \
        gzip \
        jq \
        sudo \
        locales \
        build-essential \
        pkg-config \
        cmake \
        ninja-build \
        gettext \
        ripgrep \
        fd-find \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        nodejs \
        npm \
        lua5.1 \
        liblua5.1-0-dev \
        lua5.4 \
        liblua5.4-dev \
        luajit \
        libluajit-5.1-dev \
        luarocks \
        libssl-dev \
        libsqlite3-dev \
        libreadline-dev \
        zlib1g-dev \
        libffi-dev \
        libpcre2-dev \
        libcurl4-openssl-dev; \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd; \
    echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen; \
    locale-gen en_US.UTF-8; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tmp/nvim-linux-x86_64.tar.gz \
        "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-x86_64.tar.gz"; \
    rm -rf /opt/nvim /opt/nvim-linux-x86_64; \
    tar -xzf /tmp/nvim-linux-x86_64.tar.gz -C /opt; \
    mv /opt/nvim-linux-x86_64 /opt/nvim; \
    ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim; \
    rm /tmp/nvim-linux-x86_64.tar.gz; \
    nvim --version | head -n 5

RUN set -eux; \
    luarocks --lua-version=5.1 install busted 2.2.0; \
    luarocks --lua-version=5.1 install luacheck 1.2.0; \
    luarocks --lua-version=5.1 install luacov 0.16.0; \
    luarocks --lua-version=5.1 install luafilesystem; \
    luarocks --lua-version=5.4 install busted 2.2.0; \
    luarocks --lua-version=5.4 install luacheck 1.2.0; \
    luarocks --lua-version=5.4 install luacov 0.16.0; \
    luarocks --lua-version=5.4 install luafilesystem

RUN set -eux; \
    lua -v; \
    lua5.1 -v; \
    lua5.4 -v; \
    luajit -v; \
    luarocks --version; \
    busted --version; \
    luacheck --version; \
    nvim --version | head -n 5; \
    python3 --version; \
    node --version; \
    npm --version; \
    rg --version | head -n 1; \
    fd --version; \
    git --version

WORKDIR /workspace
