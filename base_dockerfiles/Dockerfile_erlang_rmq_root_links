# R4 closure plus the two root-level include links required by a root-mounted
# RabbitMQ plugin checkout.  No project source or dependency is added here.
FROM erlang_base:v2026-08-20-e27-rmqsts-bdf98c8-r4deps205

USER root
RUN test -f /opt/rabbitmq-server/erlang.mk \
 && test -f /opt/rabbitmq-server/rabbitmq-components.mk \
 && ! test -e /erlang.mk \
 && ! test -e /rabbitmq-components.mk \
 && ln -s /opt/rabbitmq-server/erlang.mk /erlang.mk \
 && ln -s /opt/rabbitmq-server/rabbitmq-components.mk /rabbitmq-components.mk \
 && test "$(readlink /erlang.mk)" = /opt/rabbitmq-server/erlang.mk \
 && test "$(readlink /rabbitmq-components.mk)" = /opt/rabbitmq-server/rabbitmq-components.mk

WORKDIR /workspace
