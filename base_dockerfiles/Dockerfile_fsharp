# F# audit and execution-validation base image.
# .NET SDK 8 includes the F# compiler and supports the common net8/netstandard
# project targets. Version-specific cohorts are added only when audit evidence
# identifies a project that requires a different SDK/runtime.
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/sdk:8.0

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC \
    DOTNET_CLI_HOME=/workspace/.dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    NUGET_PACKAGES=/workspace/.nuget/packages \
    XDG_CACHE_HOME=/workspace/.cache \
    XDG_CONFIG_HOME=/workspace/.config \
    XDG_DATA_HOME=/workspace/.local/share

# Native tooling covers normal Paket/NuGet restores, Fable-style Node tooling,
# and managed packages with native build steps. Project-specific dependencies
# remain in each audited install_config.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    file \
    git \
    gnupg \
    jq \
    libgdiplus \
    libicu-dev \
    libpq-dev \
    libssl-dev \
    nodejs \
    npm \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    unzip \
    wget \
    zip \
    zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

RUN adduser --disabled-password --gecos '' nonroot \
 && mkdir -p /workspace/.dotnet /workspace/.nuget/packages /workspace/.cache \
 && chown -R nonroot:nonroot /workspace \
 && git config --system --add safe.directory '*'

WORKDIR /workspace
