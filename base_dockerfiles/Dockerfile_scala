# Scala build container (Linux/amd64).
# RECONSTRUCTED from the recorded configuration of scala_base:v2026-06-29-scala-rebench
# (Temurin JDK 17, Scala 3.7.3, sbt 1.11.7, Ubuntu 24.04 layout with the JDK in
# /opt/java/openjdk, workspace-scoped sbt/Ivy/Coursier caches, /workspace workdir).
FROM --platform=linux/amd64 eclipse-temurin:17.0.15_6-jdk-noble

ARG DEBIAN_FRONTEND=noninteractive
ARG SCALA_VERSION=3.7.3
ARG SBT_VERSION=1.11.7
ENV TZ=Etc/UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl wget unzip zip ca-certificates build-essential gnupg \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz" \
        | tar -xz -C /usr/local --strip-components=1 \
    && curl -fsSL "https://github.com/scala/scala3/releases/download/${SCALA_VERSION}/scala3-${SCALA_VERSION}-x86_64-pc-linux.tar.gz" \
        | tar -xz -C /usr/local --strip-components=1

ENV SBT_OPTS="-Dsbt.global.base=/workspace/.sbt -Dsbt.ivy.home=/workspace/.ivy2" \
    COURSIER_CACHE=/workspace/.cache/coursier \
    XDG_CACHE_HOME=/workspace/.cache

RUN mkdir -p /workspace/.ivy2 /workspace/.sbt /workspace/.cache/coursier \
    && chmod -R a+rwx /workspace \
    && sbt --script-version && scala -version

WORKDIR /workspace
